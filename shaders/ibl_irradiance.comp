#version 450

// Diffuse IBL: convolve the environment into a cosine-weighted irradiance map. Output is an
// equirectangular image; each texel holds the total irradiance arriving at a surface whose
// normal points in that texel's direction.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D envMap;                    // equirectangular HDR
layout(binding = 1, rgba16f) uniform writeonly image2D outIrradiance;

const float PI = 3.14159265359;
const vec2 invAtan = vec2(0.1591, 0.3183); // (1/2pi, 1/pi)

vec2 dirToUv(vec3 d) {
    vec2 uv = vec2(atan(d.z, d.x), asin(clamp(d.y, -1.0, 1.0)));
    return uv * invAtan + 0.5;
}
vec3 uvToDir(vec2 uv) {
    float phi = (uv.x - 0.5) * 2.0 * PI;
    float theta = (uv.y - 0.5) * PI;
    float ct = cos(theta);
    return normalize(vec3(cos(phi) * ct, sin(theta), sin(phi) * ct));
}

void main() {
    ivec2 size = imageSize(outIrradiance);
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (gid.x >= size.x || gid.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(gid) + 0.5) / vec2(size);
    vec3 N = uvToDir(uv);

    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = normalize(cross(N, right));

    vec3 irradiance = vec3(0.0);
    float samples = 0.0;
    const float delta = 0.025;
    for (float phi = 0.0; phi < 2.0 * PI; phi += delta) {
        for (float theta = 0.0; theta < 0.5 * PI; theta += delta) {
            // Sample direction in tangent space, then transform to world.
            vec3 tangent = vec3(sin(theta) * cos(phi), sin(theta) * sin(phi), cos(theta));
            vec3 dir = tangent.x * right + tangent.y * up + tangent.z * N;
            // Weight by cos(theta) (Lambert) and sin(theta) (solid-angle of the sample).
            irradiance += texture(envMap, dirToUv(dir)).rgb * cos(theta) * sin(theta);
            samples += 1.0;
        }
    }
    irradiance = PI * irradiance / samples;
    imageStore(outIrradiance, gid, vec4(irradiance, 1.0));
}
